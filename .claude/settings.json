      "Glob",
      "Grep",
      "WebFetch(domain:code.claude.com)",
      "Write(./**)",
      "Write(~/.claude/projects/*/memory/**)",
      "Edit(./**)",
      "Edit(~/.claude/projects/*/memory/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git *log *)",
      "Bash(git *add *)",
      "Bash(git *commit *)",
      "Bash(gh *run *)",
      "Bash(jq *)",
      "Bash(open *)",
      "Bash(ghostty *)",
      "Bash(tmux *)",
      "Bash(rm ~/.claude/projects/*/memory/*.md)",
      "Bash(swift *)",
      "Bash(swiftc *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(xcrun xcdevice *)",
      "Bash(xcrun xctrace *)",
      "Bash(xcrun --find *)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.cer)",
      "Read(**/*.p8)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/.env*)",
      "Read(**/client_secret*)",
      "Read(**/secrets.*)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.docker/**)",
      "Read(**/Keychains/**)",
      "Read(**/.git/**)",
      "Read(//etc/passwd)",
      "Read(//etc/shadow)",
      "Read(//etc/sudoers)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Write(**/*.p12)",
      "Write(**/*.cer)",
      "Write(**/*.p8)",
      "Write(**/*.crt)",
      "Write(**/*.cert)",
      "Write(**/.env*)",
      "Write(**/client_secret*)",
      "Write(**/secrets.*)",
      "Write(**/secrets/**)",
      "Write(**/.ssh/**)",
      "Write(**/.aws/**)",
      "Write(**/.gnupg/**)",
      "Write(**/.netrc)",
      "Write(**/.npmrc)",
      "Write(**/.docker/**)",
      "Write(**/.git/**)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.p12)",
      "Edit(**/*.cer)",
      "Edit(**/*.p8)",
      "Edit(**/*.crt)",
      "Edit(**/*.cert)",
      "Edit(**/.env*)",
      "Edit(**/client_secret*)",
      "Edit(**/secrets.*)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/.gnupg/**)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.docker/**)",
      "Edit(**/.git/**)",
      "Glob(//*)",
      "Bash(gh auth logout*)",
      "Bash(gh repo delete *)",
      "Bash(gh gist create *)",
      "Bash(gh gist edit *)",
      "Bash(gh release delete *)",
      "Bash(gh secret set *)",
      "Bash(gh ssh-key add *)",
      "Bash(gh api *-X POST */gists*)",
      "Bash(gh api *--method POST */gists*)",
      "Bash(gh api */gists *-X POST*)",
      "Bash(gh api */gists *--method POST*)",
      "Bash(gh auth refresh *--scopes*)",
      "Bash(gh auth refresh *-s *)",
      "Bash(git *checkout -- *)",
      "Bash(git *branch -D *)",
      "Bash(git *branch --delete --force*)",
      "Bash(git *stash drop*)",
      "Bash(git *clean -f*)",
      "Bash(git *filter-branch*)",
      "Bash(git *push --force*)",
      "Bash(git *push -f*)",
      "Bash(git *push --mirror*)",
      "Bash(git *update-ref*)",
      "Bash(git *reset --hard*)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(snow stage *)",
      "Bash(snow sql * -o *)",
      "Bash(snow sql * --output *)",
      "Bash(snow sql * > *)",
      "Bash(snow sql * >> *)",
      "Bash(snow sql * | *)",
      "Bash(dd if=*)",
      "Bash(mkfs *)",
      "Bash(mkfs.*)",
      "Bash(find / *)",
      "Bash(find /Users *)",
      "Bash(find /etc *)",
      "Bash(find /private *)",
      "Bash(ls /)",
      "Bash(ls /etc *)",
      "Bash(ls /private *)"
    ],
    "ask": [
      "Bash(gh api *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(gh repo clone *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo create *)",
      "Bash(gh auth refresh *)",
      "Bash(gh workflow run *)",
      "Bash(gh auth login *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git config *)",
      "Bash(git tag *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(chmod -R *)",
      "Bash(chmod *777*)",
      "Bash(chmod *+w*)",
      "Bash(chmod *+rw*)",
      "Bash(chmod *=rwx*)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(rake *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(xargs rm*)",
      "Bash(truncate *)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Git のブランチ削除系操作を一切行わない。具体的には: ローカル削除 (`git branch -D`, `git branch --delete --force`)、リモート削除 (`git push --delete`, `git push <remote> :<branch>` 形式, `git push --mirror`)、および `gh api` での DELETE による `refs/heads/*` 削除 (`gh api -X DELETE /repos/<owner>/<repo>/git/refs/heads/<branch>` や `--method DELETE` 相当)。理由: ブランチ削除は実質不可逆で、進行中の作業やレビュー対象、未マージのコミットを消失させるリスクが高い。削除が必要だとユーザーに思える場合でも、まず別ブランチに退避させるか明示的な確認を取ること。",
      "シークレット・認証情報の値を標準出力やログに出さない。禁止されるのは API トークン・API キー・パスワード・OAuth トークン等（環境変数名としては `*_TOKEN`, `*_API_KEY`, `*_SECRET`, `*_PASSWORD`, `GH_TOKEN`, `OPENAI_API_KEY`, `CHATWORK_API_TOKEN` 等）の生値を `echo $TOKEN`, `echo \"$SECRET\"`, `env`, `printenv`, `env | grep TOKEN` 等で表示する操作、および `.env` ファイル・`~/.netrc`・`~/.aws/credentials` のような認証情報を含むファイルを `cat`/`Read` で開いて中身を会話ログに残す操作。デバッグや動作確認が目的でも例外なし。存在確認は `[ -n \"$VAR\" ] && echo set` のようなマスクされた形で行うか、`curl -H \"...: $TOKEN\"` のように直接参照するだけで済ませる。理由: 会話ログに生値が残った時点でそのシークレットは事実上 burn され、再発行が必要になる。"
    ]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c --arg t \"$(date '+%Y-%m-%dT%H:%M:%S')\" '{ts:$t, status:\"ok\", tool:.tool_name, detail:(if .tool_name==\"Bash\" then (.tool_input.command // \"\" | split(\" \")[0]) elif .tool_name==\"Skill\" then .tool_input.skill elif .tool_name==\"Agent\" then (.tool_input.subagent_type // .tool_input.description) else (.tool_input.file_path // .tool_input.pattern // null) end)}' >> /tmp/claude_tool_log.jsonl",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c --arg t \"$(date '+%Y-%m-%dT%H:%M:%S')\" '{ts:$t, status:\"fail\", tool:.tool_name, detail:(if .tool_name==\"Bash\" then (.tool_input.command // \"\" | split(\" \")[0]) elif .tool_name==\"Skill\" then .tool_input.skill elif .tool_name==\"Agent\" then (.tool_input.subagent_type // .tool_input.description) else (.tool_input.file_path // .tool_input.pattern // null) end)}' >> /tmp/claude_tool_log.jsonl",
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline --show-model --show-branch --show-dirty --show-bar --no-usage --no-cost --show-rate --rate-bar-length 10",
    "padding": 0
  },
  "enabledPlugins": {
    "core@KNT-claude-code-plugins": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "KNT-claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "kentanakae/claude-code-plugins"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "日本語",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "*.github.com",
        "*.githubusercontent.com"
      ],
      "deniedDomains": [
        "gist.github.com",
        "gist.githubusercontent.com"
      ],
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    },
    "filesystem": {
      "allowWrite": [],
      "denyWrite": [],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/.claude",
        "~/.local",
        "~/.gitconfig",
        "~/.nvm"
      ]
    },
    "excludedCommands": [
      "gh:*",
      "codex:*",
      "gemini:*",
      "tmux:*",
      "git:*",
      "open:*",
      "claude:*",
      "ghostty:*"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "首をゆっくり右に倒して",
      "首をゆっくり左に倒して",
      "首をゆっくり一周まわして",
      "両肩をグッと上げてストン",
      "肩を前に10回まわして",
      "肩を後ろに10回まわして",
      "右腕を左に引いて肩伸ばして",
      "左腕を右に引いて肩伸ばして",
      "両手を後ろで組んで胸開いて",
      "手首をぐるぐる回して",
      "指を一本ずつ反らして",
      "手をグーパーグーパー10回",
      "両腕上げて全力バンザイ",
      "背中丸めて肩甲骨伸ばして",
      "上半身を右にひねって",
      "上半身を左にひねって",
      "右に体を倒して側面伸ばして",
      "左に体を倒して側面伸ばして",
      "目をギュッと閉じてパッと開いて",
      "目を上下左右にゆっくり動かして",
      "遠くを10秒見て",
      "足首をぐるぐる回して",
      "つま先を上げ下げ10回",
      "かかとを上げ下げ10回",
      "片足ずつ前に伸ばして",
      "顎を引いて首の後ろ伸ばして",
      "深呼吸3回して",
      "手のひら反らして手首伸ばして",
      "立ち上がって屈伸して",
      "目薬さして",
      "vim: `Esc` で NORMAL モードに戻る",
      "vim: `i` で INSERT、`a` でカーソル後ろから、`I` 行頭から、`A` 行末から",
      "vim: `o` で下に新行 INSERT、`O` で上に新行 INSERT",
      "vim: `gi` で最後の INSERT 位置に戻って INSERT",
      "vim: `0` で行頭、`^` で最初の非空白、`$` で行末",
      "vim: `w` で次の単語、`b` で前の単語",
      "vim: `gg` で先頭、`G` で末尾",
      "vim: `{` `}` で段落単位で移動",
      "vim: `Ctrl-d` / `Ctrl-u` で半画面スクロール",
      "vim: `H` / `M` / `L` で画面の上/中/下へ",
      "vim: `Ctrl-o` / `Ctrl-i` でジャンプ履歴",
      "vim: `f<char>` でその文字へ、`t<char>` で手前まで、`;` `,` で再ジャンプ",
      "vim: `%` で対応する括弧へ",
      "vim: `zz` でカーソル行を画面中央へ",
      "vim: `gd` でローカル定義へジャンプ",
      "vim: `ma` でマーク、`'a` でジャンプ、`` ` ` `` で直前位置に戻る",
      "vim: `*` / `#` でカーソル下の単語を順/逆方向検索、`n` / `N` で次/前",
      "vim: `:%s/foo/bar/g` で全置換",
      "vim: `:%s/foo/bar/gc` で確認付き全置換",
      "vim: `:noh` で検索ハイライトを消す",
      "vim: `x` で 1 文字削除、`dd` で 1 行削除、`D` でカーソルから行末まで削除",
      "vim: `dw` で 1 単語削除、`daw` / `diw` で単語ごと削除（外側込み/中身のみ）",
      "vim: `dap` で段落ごと削除",
      "vim: `cw` で単語を書き直す、`C` で行末まで書き直し",
      "vim: `ciw` で単語まるごと書き換え",
      "vim: `ci\"` でクオート内を書き換え",
      "vim: `cit` でタグの中身を書き換え",
      "vim: `r` + 文字で 1 文字置換",
      "vim: `J` で行を結合",
      "vim: `~` で大文字小文字反転",
      "vim: `gUiw` で単語を大文字化",
      "vim: `xp` で隣の文字と入れ替え",
      "vim: `>>` でインデント追加、`==` でオートインデント",
      "vim: `Ctrl-a` で数字を +1、`Ctrl-x` で -1",
      "vim: `gqip` で段落を自動整形",
      "vim: `.` で直前の操作を繰り返す",
      "vim: `u` で undo、`Ctrl-r` で redo",
      "vim: `yy` でコピー、`p` で後ろに貼り付け、`P` で前に貼り付け",
      "vim: `qa…q` で記録、`@a` で再生",
      "vim: `\"+y` でシステムクリップボードへ",
      "vim: `\"0p` で最後にヤンクした内容を貼り付け",
      "vim: `V` で行選択、`v` で文字選択",
      "vim: `Ctrl-v` で矩形選択",
      "vim: `gv` で前回の選択を復元",
      "vim: `:vsp` で縦分割、`Ctrl-w w` で切替",
      "vim: `:bn` / `:bp` でバッファ切替、`Ctrl-^` で直前のバッファ",
      "vim: `:e ファイル` で別ファイルを開く",
      "vim: `:w` 保存、`:q` 終了、`:wq` 保存+終了、`:q!` 破棄して終了"
    ]
  },
  "effortLevel": "xhigh",
  "fastMode": false,
  "companyAnnouncements": [
    "🧩 One by one. No rush.",
    "🌱 Not perfect. Just start.",
    "📝 Write it down. Keep the spark.",
    "👀 What can you do? Right now.",
    "✨ See the win. Then begin.",
    "🎸 Break the rules. Find your own."
  ],
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": false,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
