{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "excludedCommands": [
      "swift:*",
      "xcodebuild:*",
      "xcrun:*"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(swift *)",
      "Bash(swiftc *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(xcrun xcdevice *)",
      "Bash(xcrun xctrace *)",
      "Bash(xcrun --find *)"
    ],
    "ask": [
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(xargs rm*)"
    ]
  },
  "enabledPlugins": {
    "apple-dev@KNT-claude-code-plugins": true
  }
}
